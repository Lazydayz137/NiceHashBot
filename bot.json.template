{
  "RiskManagement": {
    "MaxDailySpend": 0.1,
    "MaxOrderSize": 0.01,
    "StopLossEnabled": true,
    "StopLossThreshold": 0.2,
    "MinProfitMargin": 5.0,
    "AutoExecuteMarginThreshold": 15.0
  },
