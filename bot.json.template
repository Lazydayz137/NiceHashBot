  "Performance": {
    "CacheDurationMinutes": 2,
    "RateLimitPerMinute": 100,
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 2
  },
  "Notifications": {
    "Enabled": false,
    "WebhookUrl": "",
    "NotifyOnExecution": true,
    "NotifyOnHighMargin": true,
    "HighMarginThreshold": 20.0
  }
