    "BTCAddress": "YOUR_BTC_ADDRESS_HERE",
    "WorkerPrefix": "NHB3"
  },
  "NiceHash": {
    "BTCAddress": "YOUR_NICEHASH_BTC_ADDRESS_HERE",
    "DefaultMarket": "USA",
    "OrderType": "STANDARD"
  },
  "Arbitrage": {
    "ScanIntervalMinutes": 5,
    "DefaultHashrateMultiplier": 1000,
    "MinimumOpportunities": 1,
    "PreferredMetric": "Actual24h",
